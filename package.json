{
  "name": "js-portable-dtr-lan",
  "version": "1.0.0",
  "description": "Portable LAN-based DTR Manager with Express, SQLite, and Electron launcher support.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "electron": "electron .",
    "dist": "electron-builder --win --dir"
  },
  "keywords": [
    "dtr",
    "attendance",
    "express",
    "sqlite",
    "electron",
    "lan"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "archiver": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsqr": "^1.4.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "productName": "DTR Manager",
    "executableName": "DTRManager",
    "asar": false,
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!server/**/*",
      "!frontend/**/*",
      "!database/**/*",
      "!app-settings.json"
    ],
    "win": {
      "target": "dir"
    }
  }
}
